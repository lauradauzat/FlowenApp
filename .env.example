# Database
# For local development, use a local PostgreSQL instance or a service like Supabase/Neon
# For production on Vercel, use Vercel Postgres (Neon)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public

# Local development example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/flowen_app?schema=public"

# Vercel Postgres (Neon) example:
# DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/flowen_app?schema=public"

# Auth.js v5 — ne commitez jamais votre vrai secret ; générez-le localement :
# npx auth secret   ou   openssl rand -base64 32
AUTH_SECRET="remplacez-par-un-secret-genere-en-local"

# Email (Resend) — campagnes / envoi (voir https://resend.com )
# En prod (ex. Vercel) : ajoutez ces variables dans le tableau « Environment Variables ».
RESEND_API_KEY="re_VOTRE_CLE_API_RESEND"
EMAIL_FROM="Flowen <onboarding@resend.dev>"

# Epic 7: Relances automatiques (cron)
# Si défini, Vercel envoie Authorization: Bearer <CRON_SECRET> lors des crons.
# CRON_SECRET="votre-secret-cron"