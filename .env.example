# Database
# For local development, use a local PostgreSQL instance or a service like Supabase/Neon
# For production on Vercel, use Vercel Postgres (Neon)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public

# Local development example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/flowen_app?schema=public"

# Vercel Postgres (Neon) example:
# DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Auth.js v5
# Generate a secret with: npx auth secret
# Or use: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"


# Email (Resend) - pour les campagnes de mailing Epic 6
# Créez un compte sur https://resend.com et récupérez une clé API
RESEND_API_KEY="re_HwmXras9_LNyUTGGTT5kc2sgfgrCmhDBh"
EMAIL_FROM="Mrs Capuche <mrs.capuche@gmail.com>"

# Epic 7: Relances automatiques (cron)
# Si défini, Vercel envoie Authorization: Bearer <CRON_SECRET> lors des crons.
# CRON_SECRET="votre-secret-cron"