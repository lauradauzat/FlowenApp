// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // endpoint pooler
  directUrl = env("DATABASE_URL_UNPOOLED") // endpoint direct pour migrations
}

// Auth.js v5 tables
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")

  accounts Account[]
  sessions Session[]
  projects Project[]
  contacts Contact[]
  venues   Venue[]
  scrapingSources ScrapingSource[]
  scrapingJobs ScrapingJob[]
  mailTemplates MailTemplate[]
  campaigns     Campaign[]
  tourDates     TourDate[]
  userSettings  UserSettings?

  @@map("users")
}

// Epic 10: Paramètres utilisateur (relances par défaut, tableau de bord)
model UserSettings {
  id     String  @id @default(cuid())
  userId String  @unique @map("user_id")

  relanceFirstDelayDays Int?    @map("relance_first_delay_days")
  relanceNextDelayDays  Int?    @map("relance_next_delay_days")
  relanceMax            Int?    @map("relance_max")
  relanceTemplateId     String? @map("relance_template_id")

  dashboardLimitNextSteps  Int?  @map("dashboard_limit_next_steps")
  dashboardLimitCampaigns  Int?  @map("dashboard_limit_campaigns")
  dashboardLimitResponses  Int?  @map("dashboard_limit_responses")
  dashboardShowNextSteps   Boolean? @map("dashboard_show_next_steps")
  dashboardShowResponses   Boolean? @map("dashboard_show_responses")
  dashboardShowCampaigns   Boolean? @map("dashboard_show_campaigns")
  dashboardShowMesProjets  Boolean? @map("dashboard_show_mes_projets")

  // Story 10.1: paramètres scraping (mise à jour auto globale, fréquence par défaut nouvelles sources)
  scrapingAutoUpdateEnabled Boolean?  @map("scraping_auto_update_enabled")  // true = activé
  scrapingDefaultFrequency  String?   @map("scraping_default_frequency")    // daily, weekly, monthly, null=manual

  // Story 10.3: paramètres fiches contact/venue (visible, required, defaultValue par champ)
  ficheContactFields Json? @map("fiche_contact_fields")
  ficheVenueFields   Json? @map("fiche_venue_fields")

  /** Expéditeur des campagnes (Resend) : email ou « Nom <email> » ; null = EMAIL_FROM serveur */
  mailingFrom String? @map("mailing_from") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Epic 2: Projets musicaux
enum ProjectType {
  EP
  ALBUM
  TOURNEE
  SINGLE
}

enum StepStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

// Epic 3: Contacts & Salles
enum ContactStatus {
  ACTIVE
  ARCHIVED
  ERROR
}

enum VenueStatus {
  ACTIVE
  ARCHIVED
  ERROR
}

enum DataSource {
  SCRAPING
  API
  CSV
  MANUAL
}

model Project {
  id          String       @id @default(cuid())
  name        String
  type        ProjectType
  userId      String       @map("user_id")
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps           ProjectStep[]
  personalData    ProjectPersonalData?
  campaigns       Campaign[]
  tourDates       TourDate[]

  @@index([userId])
  @@map("projects")
}

model ProjectStep {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  name        String
  status      StepStatus  @default(TODO)
  order       Int
  plannedDate DateTime?   @map("planned_date")
  actualDate  DateTime?   @map("actual_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_steps")
}

// Epic 2: Données personnelles du projet
model ProjectPersonalData {
  id          String   @id @default(cuid())
  projectId   String   @unique @map("project_id")
  bio         String?  @db.Text
  photos      String[] // Array d'URLs de photos
  videos      String[] // Array d'URLs de vidéos
  socialLinks Json?    // JSON avec { instagram?: string, facebook?: string, spotify?: string, etc. }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_personal_data")
}

model Contact {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  firstName  String       @map("first_name")
  lastName   String       @map("last_name")
  email      String?
  phone      String?
  role       String?
  notes      String?      @db.Text
  status     ContactStatus @default(ACTIVE)
  dataSource DataSource   @default(MANUAL) @map("data_source")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  venues             ContactVenue[]
  campaignRecipients CampaignRecipient[]
  campaignResponses  CampaignResponse[]
  tourDates          TourDate[]

  @@index([userId])
  @@map("contacts")
}

model Venue {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  name       String
  address    String?
  capacity   Int?
  style      String?
  region     String?
  website    String?
  notes      String?     @db.Text
  status     VenueStatus @default(ACTIVE)
  dataSource DataSource  @default(MANUAL) @map("data_source")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts             ContactVenue[]
  campaignRecipients   CampaignRecipient[]
  campaignResponses    CampaignResponse[]
  tourDates            TourDate[]

  @@index([userId])
  @@map("venues")
}

// Epic 3: Relations many-to-many entre contacts et salles
model ContactVenue {
  id        String   @id @default(cuid())
  contactId String   @map("contact_id")
  venueId   String   @map("venue_id")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([contactId, venueId])
  @@index([contactId])
  @@index([venueId])
  @@map("contact_venues")
}

// Epic 4: Scraping et Import de Données
enum ScrapingSourceType {
  WEBSITE
  API
  CUSTOM
}

model ScrapingSource {
  id           String              @id @default(cuid())
  userId       String               @map("user_id")
  name         String
  type         ScrapingSourceType
  url          String?
  selectors    Json?                // JSON avec sélecteurs CSS/XPath ou config API
  apiKey       String?              @map("api_key") @db.Text
  isActive     Boolean              @default(false) @map("is_active")
  frequency    String?              // daily, weekly, monthly, manual
  lastScrapedAt DateTime?           @map("last_scraped_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scrapingJobs ScrapingJob[]
  venueCache PublicVenueCache[]
  contactCache PublicContactCache[]

  @@index([userId])
  @@index([isActive])
  @@map("scraping_sources")
}

// Epic 4: Jobs de scraping asynchrones
enum ScrapingJobType {
  VENUES
  CONTACTS
}

enum ScrapingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ScrapingJob {
  id           String             @id @default(cuid())
  userId       String              @map("user_id")
  sourceId     String?             @map("source_id")
  type         ScrapingJobType
  status       ScrapingJobStatus   @default(PENDING)
  resultCount  Int?                @map("result_count")
  errorMessage String?             @map("error_message") @db.Text
  startedAt    DateTime?           @map("started_at")
  completedAt  DateTime?           @map("completed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source ScrapingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([sourceId])
  @@map("scraping_jobs")
}

// Epic 4: Cache pour éviter re-scraping inutile
model PublicVenueCache {
  id        String   @id @default(cuid())
  sourceId  String   @map("source_id")
  sourceUrl String   @map("source_url") @db.Text
  data      Json     // Données scrapées
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source ScrapingSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([expiresAt])
  @@map("public_venue_cache")
}

model PublicContactCache {
  id        String   @id @default(cuid())
  sourceId  String   @map("source_id")
  sourceUrl String   @map("source_url") @db.Text
  data      Json     // Données scrapées
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source ScrapingSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([expiresAt])
  @@map("public_contact_cache")
}

// Epic 5: Templates de Mailing
model MailTemplate {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  subject   String   @db.Text
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants           MailTemplateVariant[]
  campaignsAsMain    Campaign[]           @relation("MainTemplate")
  campaignsAsRelance Campaign[]           @relation("RelanceTemplate")

  @@index([userId])
  @@map("mail_templates")
}

// Story 5.3: Variantes selon capacité, région, style (fallback sur template par défaut)
model MailTemplateVariant {
  id               String   @id @default(cuid())
  mailTemplateId   String   @map("mail_template_id")
  capacityCategory String?  @map("capacity_category") // 'petite' | 'moyenne' | 'grande', null = toute capacité
  region           String?  // null = toute région
  style            String?  // null = tout style
  subject          String   @db.Text
  body             String   @db.Text
  order            Int      @default(0) // ordre d'édition et de priorité en cas d'égalité de spécificité
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  mailTemplate MailTemplate @relation(fields: [mailTemplateId], references: [id], onDelete: Cascade)

  @@index([mailTemplateId])
  @@map("mail_template_variants")
}

// Epic 6: Campagnes de Booking
enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  PAUSED
}

enum SendStatus {
  PENDING
  SENT
  FAILED
}

enum ResponseType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

model Campaign {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  name                  String
  mailTemplateId        String         @map("mail_template_id")
  projectId             String?        @map("project_id")
  status                CampaignStatus @default(DRAFT)
  relanceEnabled        Boolean        @default(false) @map("relance_enabled")
  relanceFirstDelayDays Int?           @map("relance_first_delay_days")
  relanceNextDelayDays  Int?           @map("relance_next_delay_days")
  relanceMax            Int?           @map("relance_max")
  relanceTemplateId     String?        @map("relance_template_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailTemplate    MailTemplate  @relation("MainTemplate", fields: [mailTemplateId], references: [id], onDelete: Restrict)
  relanceTemplate MailTemplate? @relation("RelanceTemplate", fields: [relanceTemplateId], references: [id], onDelete: SetNull)
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]
  responses       CampaignResponse[]
  tourDates       TourDate[]

  @@index([userId])
  @@index([status])
  @@index([mailTemplateId])
  @@index([relanceTemplateId])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  contactId  String   @map("contact_id")
  venueId    String   @map("venue_id")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign  Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  venue    Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sends    CampaignSend[]
  responses CampaignResponse[]

  @@unique([campaignId, contactId, venueId])
  @@index([campaignId])
  @@index([contactId])
  @@index([venueId])
  @@map("campaign_recipients")
}

model CampaignSend {
  id                  String     @id @default(cuid())
  campaignRecipientId String     @map("campaign_recipient_id")
  sendOrder           Int        @default(0) @map("send_order") // 0 = envoi initial, 1+ = relance
  status              SendStatus @default(PENDING)
  subject             String     @db.Text
  body                String     @db.Text
  sentAt              DateTime?  @map("sent_at")
  errorMessage        String?    @map("error_message") @db.Text
  createdAt           DateTime   @default(now()) @map("created_at")

  campaignRecipient CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@index([campaignRecipientId])
  @@map("campaign_sends")
}

model CampaignResponse {
  id                  String       @id @default(cuid())
  campaignId          String       @map("campaign_id")
  campaignRecipientId String?      @map("campaign_recipient_id")
  contactId           String       @map("contact_id")
  venueId             String       @map("venue_id")
  type                ResponseType
  subject             String?      @db.Text
  content             String       @db.Text
  receivedAt          DateTime     @map("received_at")
  isDateObtained      Boolean      @default(false) @map("is_date_obtained")
  createdAt           DateTime     @default(now()) @map("created_at")

  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignRecipient CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tourDates        TourDate[]

  @@index([campaignId])
  @@index([contactId])
  @@index([venueId])
  @@map("campaign_responses")
}

model TourDate {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  projectId           String   @map("project_id")
  campaignId          String   @map("campaign_id")
  campaignResponseId  String?  @map("campaign_response_id")
  contactId           String   @map("contact_id")
  venueId             String   @map("venue_id")
  date                DateTime
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignResponse CampaignResponse? @relation(fields: [campaignResponseId], references: [id], onDelete: SetNull)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([campaignId])
  @@index([contactId])
  @@index([venueId])
  @@map("tour_dates")
}

